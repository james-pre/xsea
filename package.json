{
	"name": "xsea",
	"version": "1.0.0",
	"description": "Cross-platform SEA generation",
	"license": "LGPL-3.0-or-later",
	"keywords": [],
	"bin": {
		"xsea": "dist/cli.js"
	},
	"files": [
		"dist",
		"LICENSE.md"
	],
	"type": "module",
	"homepage": "https://github.com/james-pre/xsea",
	"author": "James Prevett <jp@jamespre.dev> (https://jamespre.dev)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/james-pre/xsea.git"
	},
	"bugs": {
		"url": "https://github.com/james-pre/xsea/issues"
	},
	"engines": {
		"node": ">= 16"
	},
	"exports": {
		".": "./dist/lib.js",
		"./*": "./dist/*.js"
	},
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "tsc -p tsconfig.json --noEmit && eslint src",
		"build": "tsc -p tsconfig.json",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.5",
		"@types/tar": "^6.1.13",
		"eslint": "^10.1.0",
		"globals": "^17",
		"prettier": "^3.4.1",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.0"
	},
	"dependencies": {
		"adm-zip": "^0.6.0",
		"postject": "^1.0.0-alpha.6",
		"tar": "^7.4.3"
	},
	"prettier": {
		"singleQuote": true,
		"useTabs": true,
		"trailingComma": "es5",
		"tabWidth": 4,
		"printWidth": 180,
		"arrowParens": "avoid"
	}
}
